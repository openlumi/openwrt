. /lib/functions/uci-defaults.sh
. /lib/functions/system.sh

board=$(board_name)

board_config_update

case "$board" in
technexion,imx7d-pico-pi)
	ucidef_set_interface_lan "eth0"
	;;
geniatech,gtw360)
    ucidef_set_interface_macaddr "wan" $(macaddr_generate_from_mmc_cid mmcblk1)
	ucidef_set_interfaces_lan_wan "wlan0" "eth0"
	;;
aqara,zhwg11lm|\
xiaomi,dgnwg05lm)
	# These Wi-Fi-only devices have no Ethernet ports. Define LAN without
	# a device to prevent 99-default_network from adding eth0.
	ucidef_set_interface "lan" protocol "static"
	;;
*)
	ucidef_set_interfaces_lan_wan "eth0" "eth1"
	;;
esac

board_config_flush

exit 0
